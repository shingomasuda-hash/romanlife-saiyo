# ロマンライフ 採用LP ／ 環境変数サンプル（Vercel: Settings → Environment Variables）
# 変更後は再デプロイしてください（トップページは静的生成のため、ビルド時に反映されます）。

# 本番の公開URL（canonical / OGP に使用）。例: https://example.vercel.app
NEXT_PUBLIC_SITE_URL=

# エントリーの送信先（Google Apps Script のウェブアプリURL + ?token=）
# tools/google-apps-script/saiyo-entries-to-spreadsheet.gs を参照。
# 未設定の間はフォームから送信できず、フォーム下に「デザイン確認用です。入力内容は送信されません。」が表示されます。
ENTRY_WEBHOOK_URL=

# 予備の送信先（任意）。設定すると本番と同時に同じ内容を送り、どちらかに届けば受付成立。
# 別のGoogleアカウントで同じGASを設置し（通知メールを二重にしたくなければ NOTIFY_TO は空に）、
# そのウェブアプリURL（?token= 付き）を設定する。
ENTRY_WEBHOOK_URL_BACKUP=
